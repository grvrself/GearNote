    "records.read.selected",
    "agent.chat",
    "chat.write"
  ],
  "inputs": [
    { "type": "records", "min": 2, "max": 4 }
  ],
  "steps": [
    { "action": "agent.ask", "prompt": "prompts/compare.md" }
