{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GearNote",
  "version": "0.1.0",
  "identifier": "com.knowflow.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "bundle": {
    "resources": {
      "../vendor/dsh-video-storyboard/bin": "storyboard/bin",
      "../vendor/dsh-video-storyboard/src": "storyboard/src",
      "../vendor/dsh-video-storyboard/lib": "storyboard/lib",
      "../vendor/dsh-video-storyboard/locale": "storyboard/locale",
      "../vendor/dsh-video-storyboard/package.json": "storyboard/package.json",
      "../vendor/dsh-video-storyboard/LICENSE": "storyboard/LICENSE",
      "../vendor/dsh-video-storyboard/NOTICE": "storyboard/NOTICE",
      "../extension": "extension"
    }
  },
  "app": {
    "windows": [
      { "title": "GearNote", "width": 1480, "height": 900, "minWidth": 880, "minHeight": 600, "decorations": false, "shadow": false }
    ],
    "security": { "csp": null }
  }
}
